---
import '../styles/global.css';
import { getDict, LANG_TAG, localePath, otherLang, type Lang } from '../i18n';
import { assertRulebookFresh } from '../lib/tools/config';

/* Runs at build time on every page. The site publishes a threshold and a
   penalty figure; if the rulebook claim goes stale the build fails rather
   than shipping numbers nobody has re-checked. */
assertRulebookFresh();

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const t = getDict(lang);

const site = Astro.site ?? new URL('https://cardoadvisory.com');
const canonical = new URL(Astro.url.pathname, site).href;
const other = otherLang(lang);

const alternates = [
  { hreflang: 'en', href: new URL(localePath('en'), site).href },
  { hreflang: 'hu', href: new URL(localePath('hu'), site).href },
  { hreflang: 'x-default', href: new URL(localePath('en'), site).href },
];

const ogImage = new URL(`/og-${lang}.png`, site).href;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Cardo',
  url: site.href,
  email: t.contact.email,
  description: t.meta.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Budapest', addressCountry: 'HU' },
  areaServed: 'HU',
  knowsLanguage: ['hu', 'en'],
  serviceType: t.services.items.map((s) => s.h),
};
---

<html lang={LANG_TAG[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ?? t.meta.title}</title>
    <meta name="description" content={description ?? t.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cardo" />
    <meta property="og:title" content={title ?? t.meta.title} />
    <meta property="og:description" content={description ?? t.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={t.meta.ogLocale} />
    <meta property="og:locale:alternate" content={getDict(other).meta.ogLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? t.meta.title} />
    <meta name="twitter:description" content={description ?? t.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
  </head>

  <body>
    <slot />
  </body>
</html>
