---
import Base from './Base.astro';
import Nav from '../components/nav/Nav.astro';
import Footer from '../components/nav/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import Services from '../components/sections/Services.astro';
import Sale from '../components/sections/Sale.astro';
import Acquisition from '../components/sections/Acquisition.astro';
import Method from '../components/sections/Method.astro';
import TaxRecovery from '../components/sections/TaxRecovery.astro';
import Tools from '../components/sections/Tools.astro';
import Contact from '../components/sections/Contact.astro';
import type { Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang}>
  <Nav lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Services lang={lang} />
    <Sale lang={lang} />
    <Acquisition lang={lang} />
    <Method lang={lang} />
    <TaxRecovery lang={lang} />
    <Tools lang={lang} />
    <Contact lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>
