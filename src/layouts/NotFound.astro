---
import Base from './Base.astro';
import Nav from '../components/nav/Nav.astro';
import Footer from '../components/nav/Footer.astro';
import { getDict, localePath } from '../i18n';

/* Bilingual on purpose: Cloudflare serves this single page for every 404,
   including ones under /hu/, so a Hungarian reader must not land on an
   English-only dead end. */
const en = getDict('en');
const hu = getDict('hu');
---
<Base lang="en" title={en.meta.notFoundTitle}>
  <Nav lang="en" />
  <main id="main" class="wrap narrow flex min-h-[55vh] flex-col justify-center gap-10 py-20">
    <div>
      <div class="eyebrow">{en.notFound.eyebrow}</div>
      <h2>{en.notFound.heading}</h2>
      <p>{en.notFound.body}</p>
      <div class="flex flex-wrap gap-4">
        <a class="cta" href={localePath('en')}>{en.notFound.home}</a>
        <a class="cta" href={`${localePath('en')}#tools`}>{en.notFound.tools}</a>
      </div>
    </div>
    <div class="border-t border-line pt-8" lang="hu">
      <h2 class="text-[1.5rem]">{hu.notFound.heading}</h2>
      <p>{hu.notFound.body}</p>
      <div class="flex flex-wrap gap-4">
        <a class="cta" href={localePath('hu')}>{hu.notFound.home}</a>
        <a class="cta" href={`${localePath('hu')}#tools`}>{hu.notFound.tools}</a>
      </div>
    </div>
  </main>
  <Footer lang="en" />
</Base>
