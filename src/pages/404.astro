---
import Base from '../layouts/Base.astro';
import Nav from '../components/nav/Nav.astro';
import Footer from '../components/nav/Footer.astro';
import { getDict, localePath } from '../i18n';

/* Bilingual on purpose: Cloudflare Pages serves this single page for every
   404, including ones under /hu/, so a Hungarian visitor must not land on an
   English-only dead end. */
const en = getDict('en');
const hu = getDict('hu');
---

<Base lang="en" title={en.meta.notFoundTitle}>
  <Nav lang="en" />
  <main class="wrap flex min-h-[60vh] flex-col justify-center gap-10 py-20">
    <div class="max-w-[var(--container-prose)]">
      <div class="mb-4 font-mono text-xs uppercase tracking-[0.14em] text-accent">
        {en.notFound.eyebrow}
      </div>
      <h1 class="mb-4 text-h2 font-bold tracking-display">{en.notFound.heading}</h1>
      <p class="mb-6 text-lg text-text-muted">{en.notFound.body}</p>
      <div class="flex flex-wrap gap-3.5">
        <a href={localePath('en')} class="btn btn-primary">{en.notFound.home}</a>
        <a href={`${localePath('en')}#tp-calc`} class="btn btn-ghost">
          {en.notFound.calculator}
        </a>
      </div>
    </div>

    <div class="max-w-[var(--container-prose)] border-t border-border pt-8" lang="hu">
      <h2 class="mb-3 text-2xl font-semibold">{hu.notFound.heading}</h2>
      <p class="mb-5 text-base text-text-muted">{hu.notFound.body}</p>
      <div class="flex flex-wrap gap-3.5">
        <a href={localePath('hu')} class="btn btn-ghost btn-sm">{hu.notFound.home}</a>
        <a href={`${localePath('hu')}#tp-calc`} class="btn btn-ghost btn-sm">
          {hu.notFound.calculator}
        </a>
      </div>
    </div>
  </main>
  <Footer lang="en" />
</Base>
