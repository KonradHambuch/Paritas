---
import SectionHead from '../ui/SectionHead.astro';
import InlineTool from '../ui/InlineTool.astro';
import { getDict, type Lang } from '../../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
---
<section id="acquisition" class="section">
  <div class="wrap">
    <SectionHead
      eyebrow={t.acquisition.eyebrow}
      heading={t.acquisition.heading}
      lede={t.acquisition.lede}
    />
    <div class="mt-[38px] grid gap-8 md:grid-cols-3 md:gap-10">
      {
        t.acquisition.items.map((s) => (
          <div class="svc">
            <h3>{s.h}</h3>
            <p>{s.p}</p>
          </div>
        ))
      }
    </div>
    <InlineTool {...t.acquisition.tool} href="#tool-readiness" />
  </div>
</section>
