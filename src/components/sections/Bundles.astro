---
import SectionHead from '../ui/SectionHead.astro';
import { getDict, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const b = t.bundles;
---

<section id="bundles" class="section-y border-y border-border bg-surface-raised">
  <div class="wrap">
    <SectionHead tag={b.tag} heading={b.heading} />

    <div class="reveal-stagger grid gap-5 md:grid-cols-3">
      {
        b.items.map((item, i) => (
          <div
            class:list={[
              'card card-interactive flex flex-col',
              /* ring instead of a 2px border: same emphasis, no 1px content
                 shift against its siblings */
              i === 1 && 'ring-2 ring-accent shadow-[0_0_0_6px_var(--accent-soft)]',
            ]}
          >
            {i === 1 && (
              <span class="absolute -top-3 left-6 rounded-full bg-accent px-2.5 py-0.5 font-mono text-2xs tracking-[0.1em] text-on-accent">
                {b.mostChosen}
              </span>
            )}
            <h3 class="mb-1 text-xl font-semibold">{item.h}</h3>
            <div class="my-3 font-mono text-[1.625rem] font-semibold text-accent">
              {item.price}{' '}
              <small class="text-sm font-normal text-text-muted">{item.priceNote}</small>
            </div>
            <ul class="flex-1 list-none">
              {item.points.map((pt) => (
                <li class="relative py-1.5 pl-5 text-sm text-text-muted before:absolute before:left-0 before:font-semibold before:text-accent before:content-['—']">
                  {pt}
                </li>
              ))}
            </ul>
            <a
              href="#contact"
              class:list={['btn btn-sm mt-4', i === 1 ? 'btn-primary' : 'btn-ghost']}
            >
              {item.cta}
            </a>
          </div>
        ))
      }
    </div>

    <p class="mt-5 text-center text-sm text-text-muted" set:html={b.tracker} />

    <div class="mt-7 flex flex-wrap items-center justify-between gap-5 rounded-[var(--radius-card)] border border-border bg-accent-soft px-7 py-5">
      <p class="max-w-[46em] text-base text-text-muted [&_b]:text-text-strong" set:html={b.trustStrip} />
      <a href="#contact" class="btn btn-ghost btn-sm">{b.trustCta}</a>
    </div>
  </div>
</section>
