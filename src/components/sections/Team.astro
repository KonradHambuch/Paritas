---
import SectionHead from '../ui/SectionHead.astro';
import Card from '../ui/Card.astro';
import { getDict, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
---

<section id="team" class="section-y border-t border-border bg-surface-raised">
  <div class="wrap">
    <SectionHead tag={t.team.tag} heading={t.team.heading} lede={t.team.lede} />
    <div class="reveal-stagger grid gap-5 md:grid-cols-3">
      {
        t.team.cards.map((c) => (
          <Card k={c.k} h={c.h}>
            <p class="text-base text-text-muted">{c.p}</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
