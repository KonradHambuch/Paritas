---
import SectionHead from '../ui/SectionHead.astro';
import { getDict, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
---

<section id="faq" class="section-y border-t border-border bg-surface-raised">
  <div class="wrap">
    <SectionHead tag={t.faq.tag} heading={t.faq.heading} />
    <div class="max-w-[var(--container-prose)]">
      {
        t.faq.items.map((item) => (
          <details class="faq-item reveal mb-2.5 overflow-hidden rounded-xl border border-border bg-surface">
            <summary>{item.q}</summary>
            <div class="px-5 pb-4 pt-3.5 text-base text-text-muted">{item.a}</div>
          </details>
        ))
      }
    </div>
  </div>
</section>
