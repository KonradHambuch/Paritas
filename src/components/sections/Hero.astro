---
import { CONFIG } from '../../lib/calc/config';
import { fill, getDict, type Lang } from '../../i18n';
import { makeFormat } from '../../lib/format';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const fmt = makeFormat(lang);
const threshold = fmt.eurK(CONFIG.thresholds.PL_serv);
---

<header class="bg-gradient-to-b from-surface to-surface-sunken pb-16 pt-20 md:pb-[4.5rem] md:pt-[5.5rem]">
  <div class="wrap grid items-center gap-10 lg:grid-cols-[1.15fr_0.85fr] lg:gap-14">
    <div class="reveal">
      <div class="mb-4 text-balance font-mono text-xs uppercase tracking-[0.12em] text-accent">
        {t.hero.eyebrow}
      </div>
      <h1 class="text-h1 font-bold tracking-display">
        {t.hero.headingLine1}{' '}
        <span class="text-accent">{t.hero.headingLine2}</span>
      </h1>
      <p class="my-6 max-w-[34em] text-lg text-text-muted">{t.hero.lede}</p>
      <div class="flex flex-wrap gap-3.5">
        <a href="#tp-calc" class="btn btn-primary">{t.hero.ctaPrimary}</a>
        <a href="#resources" class="btn btn-ghost">{t.hero.ctaSecondary}</a>
      </div>
      <div class="mt-4 font-mono text-xs text-text-muted">
        {t.hero.note}
        <br />
        <span class="text-2xs">
          {fill(t.hero.noteSmall, { lastVerified: CONFIG.lastVerified })}
        </span>
      </div>
    </div>

    <!-- Decorative. Numbers are illustrative sample data, not a live feed;
         aria-hidden so it is never read as if it described the visitor. -->
    <div
      class="surface-ink rounded-2xl bg-surface p-7 text-text shadow-[var(--shadow-float)]"
      aria-hidden="true"
    >
      <h3 class="mb-5 font-mono text-xs font-medium uppercase tracking-[0.12em] text-text-muted">
        {t.hero.gauge.title}
      </h3>

      <div class="mb-4.5">
        <div class="mb-1.5 flex justify-between font-mono text-sm">
          <span>{fill(t.hero.gauge.row1Label, { threshold })}</span>
          <span class="font-semibold text-text-strong" id="hg1v">—</span>
        </div>
        <div class="h-2.5 overflow-hidden rounded-full bg-surface-sunken">
          <div id="hg1" class="h-full rounded-full bg-sev-red" style="width:0%"></div>
        </div>
        <div class="mt-1.5 font-mono text-2xs text-sev-red" id="hg1s">&nbsp;</div>
      </div>

      <div class="mb-4.5">
        <div class="mb-1.5 flex justify-between font-mono text-sm">
          <span>{t.hero.gauge.row2Label}</span>
          <span class="font-semibold text-text-strong" id="hg2v">—</span>
        </div>
        <div class="h-2.5 overflow-hidden rounded-full bg-surface-sunken">
          <div id="hg2" class="h-full rounded-full bg-sev-amber" style="width:0%"></div>
        </div>
        <div class="mt-1.5 font-mono text-2xs text-sev-amber" id="hg2s">
          {t.hero.gauge.row2StatusInitial}
        </div>
      </div>

      <div class="mb-4.5">
        <div class="mb-1.5 flex justify-between font-mono text-sm">
          <span>{t.hero.gauge.row3Label}</span>
          <span class="font-semibold text-text-strong">{t.hero.gauge.row3Value}</span>
        </div>
        <div class="h-2.5 overflow-hidden rounded-full bg-surface-sunken">
          <div id="hg3" class="h-full rounded-full bg-sev-amber" style="width:0%"></div>
        </div>
        <div class="mt-1.5 font-mono text-2xs text-sev-amber">{t.hero.gauge.row3Status}</div>
      </div>

      <div class="mt-1.5 flex items-baseline justify-between border-t border-border pt-4">
        <span class="font-mono text-2xs uppercase tracking-[0.1em] text-text-muted">
          {t.hero.gauge.footLabel}
        </span>
        <span class="font-mono text-[1.625rem] font-semibold text-sev-red" id="hgx">—</span>
      </div>
    </div>
  </div>
</header>

<script
  define:vars={{
    lang,
    s1: t.hero.gauge.row1Status,
    s2: t.hero.gauge.row2Status,
  }}
>
  window.__paritasLang = lang;
  window.__paritasGaugeStatus1 = s1;
  window.__paritasGaugeStatus2 = s2;
</script>
<script>
  import '../../scripts/gauge';
</script>
