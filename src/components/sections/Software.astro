---
import SectionHead from '../ui/SectionHead.astro';
import Card from '../ui/Card.astro';
import { getDict, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const s = t.software;

/* Rebranded from the legacy markup, which was entirely inline-styled in a
   foreign palette (#e2ded6 bone, #c0562a orange, #0e1216) pasted in from
   another design. It now uses the same tokens as every other section; the
   "for funds" card becomes the one ink-surface card in the grid, which is the
   device the gauge and result panels already use. */
---

<section id="software" class="section-y border-t border-border">
  <div class="wrap">
    <SectionHead tag={s.tag} heading={s.heading} lede={s.lede} />

    <div class="reveal-stagger grid gap-4.5 sm:grid-cols-2">
      {
        s.cards.map((card, i) => {
          const isFunds = i === s.cards.length - 1;
          return (
            <Card
              k={card.k}
              h={card.h}
              ink={isFunds}
              class={isFunds ? 'sm:col-span-2' : ''}
            >
              <p class="text-base text-text-muted [&_b]:text-text-strong" set:html={card.p} />
            </Card>
          );
        })
      }
    </div>

    <p
      class="reveal mt-8 max-w-[52em] text-base text-text-muted [&_b]:text-text-strong"
      set:html={s.closing}
    />
  </div>
</section>
