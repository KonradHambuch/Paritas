---
import { getDict, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const c = t.contact;

const mailto = (subject: string, body: string) =>
  `mailto:${t.footer.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---

<section id="contact" class="surface-ink section-y bg-surface text-text">
  <div class="wrap grid items-start gap-11 lg:grid-cols-[1.1fr_0.9fr]">
    <div class="reveal">
      <span class="mb-4 inline-block rounded-full border border-accent px-3 py-1 font-mono text-2xs uppercase tracking-[0.13em] text-accent">
        {c.tag}
      </span>
      <h2 class="mb-3.5 text-h2 font-bold tracking-display">{c.heading}</h2>
      <p class="text-lg text-text-muted">{c.lede}</p>
      <div class="mt-6">
        {
          c.steps.map((step, i) => (
            <div
              class:list={[
                'flex gap-3.5 py-2.5',
                i < c.steps.length - 1 && 'border-b border-border',
              ]}
            >
              <span class="font-mono font-semibold text-accent">
                {String(i + 1).padStart(2, '0')}
              </span>
              <span class="text-base">{step}</span>
            </div>
          ))
        }
      </div>
    </div>

    <div class="reveal rounded-2xl bg-surface-raised p-7">
      <p class="mb-3.5 font-mono text-2xs uppercase tracking-[0.12em] text-text-muted">
        {c.talkToUs}
      </p>
      <a href={mailto(c.emailSubject, c.emailBody)} class="btn btn-primary mb-3 w-full">
        {c.emailCta}
      </a>
      <!-- The legacy "Book a 20-minute slot" button was href="#" with no
           handler: it scrolled to the top of the page. Pointed at the same
           mailbox until a scheduler URL exists. -->
      <a href={mailto(c.bookSubject, c.bookBody)} class="btn btn-ghost w-full">
        {c.bookCta}
      </a>
      <p class="mt-4 text-sm text-text-muted">
        {c.writeDirectly}{' '}
        <a href={`mailto:${t.footer.email}`} class="font-mono text-text-strong">
          {t.footer.email}
        </a>
        <br />
        {c.locations}
      </p>
      <p class="mt-3.5 text-xs text-text-muted">{c.replyNote}</p>
    </div>
  </div>
</section>
