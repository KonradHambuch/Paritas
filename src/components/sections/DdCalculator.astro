---
import SectionHead from '../ui/SectionHead.astro';
import OptionGroup from '../calc/OptionGroup.astro';
import NumberRow from '../calc/NumberRow.astro';
import StepLabel from '../calc/StepLabel.astro';
import ResultCard from '../calc/ResultCard.astro';
import { getDict, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const c = t.ddCalc;
const r = c.results;
---

<section id="dd-calc" class="section-y">
  <div class="wrap">
    <SectionHead tag={c.tag} heading={c.heading} lede={c.lede} />

    <div class="grid items-start gap-10 lg:grid-cols-[1.05fr_0.95fr]">
      <form
        class="rounded-2xl border border-border bg-surface-raised p-7"
        id="ddform"
        onsubmit="return false"
      >
        <StepLabel first>{c.step1}</StepLabel>
        <OptionGroup
          name="ddside"
          options={[
            { value: 'buy', label: c.side.buy, checked: true },
            { value: 'sell', label: c.side.sell },
          ]}
        />

        <StepLabel>{c.step2}</StepLabel>
        <OptionGroup
          name="ddscope"
          options={[
            { value: 'rf', label: c.scope.rf, checked: true },
            { value: 'a', label: c.scope.a },
            { value: 'b', label: c.scope.b },
          ]}
        />

        <StepLabel>{c.step3}</StepLabel>
        <NumberRow id="ddEntities" label={c.entities} value={2} min={1} max={8} step={1} />
        <OptionGroup
          name="ddrev"
          options={[
            { value: '0.9', label: c.revenue.a },
            { value: '1', label: c.revenue.b, checked: true },
            { value: '1.2', label: c.revenue.c },
            { value: '1.4', label: c.revenue.d },
            { value: '1.65', label: c.revenue.e },
          ]}
        />

        <StepLabel>{c.step4}</StepLabel>
        <OptionGroup
          name="ddacct"
          options={[
            { value: '0.9', label: c.accounts.audited },
            { value: '1', label: c.accounts.reviewed },
            { value: '1.15', label: c.accounts.neither, checked: true },
          ]}
        />
        <OptionGroup
          name="ddroom"
          class="mt-2.5"
          options={[
            { value: '0.9', label: c.dataRoom.organized },
            { value: '1', label: c.dataRoom.partial, checked: true },
            { value: '1.15', label: c.dataRoom.none },
          ]}
        />

        <StepLabel>{c.step5}</StepLabel>
        <OptionGroup
          name="ddcomplexity"
          type="checkbox"
          options={[
            { value: 'dd_consol', label: c.consolidation },
            { value: 'dd_rush', label: c.rush },
          ]}
        />
        <NumberRow
          id="ddInstr"
          label={c.layers}
          value={1}
          min={0}
          max={6}
          step={1}
          class="mt-2.5"
        />
        <OptionGroup
          name="ddmodel"
          class="mt-2.5"
          options={[
            { value: '1', label: c.model.saas, checked: true },
            { value: '1.1', label: c.model.usage },
            { value: '1.2', label: c.model.hardware },
          ]}
        />

        <StepLabel>{c.step6}</StepLabel>
        <OptionGroup
          name="ddaddons"
          type="checkbox"
          options={[
            { value: 'dd_tp', label: c.addOns.tp, checked: true },
            { value: 'dd_tax', label: c.addOns.tax },
            { value: 'dd_stamp', label: c.addOns.stamp },
          ]}
        />

        <button class="btn btn-primary mt-6 w-full" id="ddRun" type="button">
          {c.run}
        </button>
      </form>

      <div id="ddResults">
        <p id="ddStatus" class="sr-only" role="status" aria-live="polite"></p>

        <div aria-live="off">
          <ResultCard title={r.quoteTitle}>
            <div id="ddQuoteOut">
              <p class="text-sm italic text-text-muted">{r.quoteEmpty}</p>
            </div>
            <p class="mt-3.5 border-t border-border pt-3 text-2xs leading-relaxed text-text-muted" id="ddFn" hidden>
              {r.footnote}
            </p>
            <a href="#contact" class="btn btn-primary mt-3.5 w-full" id="ddCta" hidden>
              {r.cta}
            </a>
          </ResultCard>

          <div
            class="rounded-2xl border border-border bg-accent-soft px-7 py-5"
            id="ddNote"
            hidden
          >
            <p class="text-sm text-text-muted [&_b]:text-text-strong" id="ddSideNote"></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- One entry point for both calculators: they share the cross-sell cache, and
     Astro bundles both into the same page chunk so the module instance is
     shared. Plain <script> rather than a framework island — the forms are
     native inputs that already own their state. -->
<script>
  import '../../scripts/calculators';
</script>
