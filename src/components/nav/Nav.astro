---
import { getDict, localePath, otherLang, LANG_TAG, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);
const other = otherLang(lang);
const otherHref = localePath(other);

/* Anchors are the same in both languages on purpose. The reference pages used
   localised ids (#services vs #szolgaltatasok), which would mean the language
   switcher could not carry the reader's place across the switch. */
const links = [
  { href: '#services', label: t.nav.links.services },
  { href: '#sale', label: t.nav.links.sale },
  { href: '#acquisition', label: t.nav.links.acquisition },
  { href: '#tax-recovery', label: t.nav.links.tax },
  { href: '#tools', label: t.nav.links.tools },
  { href: '#contact', label: t.nav.links.contact },
];
---

<a
  href="#main"
  class="absolute left-[-9999px] top-0 z-[100] bg-ink px-5 py-3 font-sans text-sm text-white focus:left-0"
>
  {t.nav.skip}
</a>

<header
  class="top sticky top-0 z-50 border-b border-line bg-paper/[0.97] backdrop-blur-[8px]"
>
  <div class="wrap flex h-[76px] items-center justify-between gap-6">
    <a href={localePath(lang)} class="brand no-underline hover:no-underline">
      {t.brand.name}<span class="hidden sm:block">{t.brand.tagline}</span>
    </a>

    <div class="flex items-center gap-5 lg:gap-[30px]">
      <nav class="hidden items-center gap-[30px] font-sans text-[0.90625rem] lg:flex">
        {
          links.map((l) => (
            <a href={l.href} class="text-body no-underline hover:underline">
              {l.label}
            </a>
          ))
        }
      </nav>

      <!-- ONE language link for every breakpoint. Rendering a second, hidden
           copy for mobile meant the phone version had no hash preservation,
           so tapping it from #tools landed the reader back at the top. -->
      <a
        id="langSwitch"
        href={otherHref}
        data-base={otherHref}
        hreflang={LANG_TAG[other]}
        lang={LANG_TAG[other]}
        rel="alternate"
        aria-label={t.nav.otherLanguageLabel}
        class="font-sans text-[0.90625rem] text-muted no-underline hover:underline lg:border-l lg:border-line lg:pl-[26px]"
      >
        {t.nav.otherLanguage}
      </a>

      <!-- Below the desktop breakpoint the reference design simply hid the nav
           with no menu at all, leaving every section unreachable on a phone.
           A native <details> disclosure needs no script to open or close and is
           correct for keyboard and screen readers by default. -->
      <details class="mnav lg:hidden" id="mobileNav">
        <summary
          class="grid size-9 place-items-center border border-line text-ink"
          aria-label={t.nav.menu}
        >
          <svg class="mnav-open size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
          <svg class="mnav-close size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19"></path>
          </svg>
        </summary>
        <div class="absolute inset-x-0 top-full border-b border-line bg-paper px-8 py-5">
          <div class="mx-auto flex max-w-[var(--container-wrap)] flex-col">
            {
              links.map((l) => (
                <a
                  href={l.href}
                  class="border-b border-line py-3 font-sans text-base text-body no-underline last:border-b-0"
                >
                  {l.label}
                </a>
              ))
            }
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  import '../../scripts/nav';
</script>
