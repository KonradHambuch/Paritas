---
import { getDict, localePath, otherLang, LANG_TAG, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);
const other = otherLang(lang);
const otherHref = localePath(other);

const links = [
  { href: '#tp-calc', label: t.nav.links.tpCalc },
  { href: '#dd-calc', label: t.nav.links.ddCalc },
  { href: '#software', label: t.nav.links.software },
  { href: '#pricing', label: t.nav.links.pricing },
  { href: '#team', label: t.nav.links.team },
  { href: '#resources', label: t.nav.links.resources },
];
---

<a
  href="#tp-calc"
  class="absolute left-[-9999px] top-0 z-[100] rounded-br-md bg-accent px-5 py-3 text-on-accent focus:left-0"
>
  {t.nav.skipToCalculator}
</a>

<nav
  class="sticky top-0 z-50 border-b border-border backdrop-blur-md"
  style="background: var(--nav-bg)"
>
  <!-- Scroll-linked reading progress. Pure CSS via animation-timeline: scroll();
       where unsupported it simply stays at zero width and is invisible. -->
  <div
    class="scroll-progress pointer-events-none absolute inset-x-0 bottom-[-1px] h-[2px] origin-left bg-accent"
    style="scale: 0 1"
    aria-hidden="true"
  >
  </div>

  <div class="wrap flex h-16 items-center justify-between gap-4">
    <a
      href={localePath(lang)}
      class="font-display text-[1.375rem] font-bold tracking-[-0.02em] text-text-strong no-underline hover:no-underline"
    >
      Pari<span class="text-accent">tas</span>
    </a>

    <div class="flex items-center gap-2 lg:gap-6">
      <div class="hidden items-center gap-6 lg:flex">
        {
          links.map((l) => (
            <a
              href={l.href}
              class="text-sm font-medium text-text no-underline hover:text-accent hover:no-underline"
            >
              {l.label}
            </a>
          ))
        }
      </div>

      <!-- Language switcher. A real <a> so it works without JS and is
           crawlable; the hash is grafted on at click time in nav.ts. -->
      <a
        id="langSwitch"
        href={otherHref}
        data-base={otherHref}
        hreflang={LANG_TAG[other]}
        lang={LANG_TAG[other]}
        rel="alternate"
        class="rounded-md border border-border px-2.5 py-1.5 font-mono text-2xs uppercase tracking-[0.08em] text-text-muted no-underline hover:border-accent hover:text-accent hover:no-underline"
        aria-label={t.nav.language}
      >
        {t.nav.otherLanguage}
      </a>

      <button
        id="themeToggle"
        type="button"
        class="grid size-9 place-items-center rounded-md border border-border text-text-muted hover:border-accent hover:text-accent"
        aria-label={t.nav.theme}
      >
        <svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>

      <a href="#tp-calc" class="btn btn-primary btn-sm hidden sm:inline-block">
        {t.nav.cta}
      </a>

      <!-- Mobile menu. A native <details> disclosure: no JS to open or close,
           correct for keyboard and screen readers by default, and consistent
           with how the FAQ and the option pills already work. The legacy page
           simply hid these links below 900px with no menu at all. -->
      <details class="mnav lg:hidden" id="mobileNav">
        <summary
          class="grid size-9 place-items-center rounded-md border border-border text-text-muted"
          aria-label={t.nav.menu}
        >
          <svg class="mnav-open size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
          <svg class="mnav-close size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 5l14 14M19 5L5 19"></path>
          </svg>
        </summary>
        <div
          class="absolute inset-x-0 top-full border-b border-border bg-surface px-6 py-5 shadow-lg"
        >
          <div class="mx-auto flex max-w-[var(--container-wrap)] flex-col gap-1">
            {
              links.map((l) => (
                <a
                  href={l.href}
                  class="rounded-md px-2 py-2.5 text-base font-medium text-text no-underline hover:bg-surface-sunken hover:no-underline"
                >
                  {l.label}
                </a>
              ))
            }
            <a href="#tp-calc" class="btn btn-primary mt-3 sm:hidden">{t.nav.cta}</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</nav>

<script>
  import '../../scripts/nav';
</script>
