---
import { CONFIG } from '../../lib/calc/config';
import { fill, getDict, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);
const f = t.footer;

const services = [
  { href: '#pricing', label: f.services.tp },
  { href: '#pricing', label: f.services.dd },
  { href: '#bundles', label: f.services.bundles },
  { href: '#bundles', label: f.services.partner },
];
const start = [
  { href: '#tp-calc', label: f.start.tpCalc },
  { href: '#dd-calc', label: f.start.ddCalc },
  { href: '#resources', label: f.start.resources },
  { href: '#team', label: f.start.team },
  { href: '#faq', label: f.start.faq },
];
---

<footer class="surface-ink surface-ink-footer bg-surface pb-10 pt-14 text-sm text-text-muted">
  <div class="wrap">
    <div class="foot-grid mb-9 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <div class="font-display text-[1.375rem] font-bold tracking-[-0.02em] text-text-strong">
          Pari<span class="text-accent">tas</span>
        </div>
        <p class="mt-3 max-w-[32em]">{f.blurb}</p>
        <p class="mt-3.5 font-mono">
          <a href={`mailto:${f.email}`}>{f.email}</a>
        </p>
      </div>
      <div>
        <h4 class="mb-3 text-base text-text-strong">{f.servicesHeading}</h4>
        {services.map((l) => <a href={l.href} class="block py-0.5 text-text-muted hover:text-accent">{l.label}</a>)}
      </div>
      <div>
        <h4 class="mb-3 text-base text-text-strong">{f.startHeading}</h4>
        {start.map((l) => <a href={l.href} class="block py-0.5 text-text-muted hover:text-accent">{l.label}</a>)}
      </div>
    </div>

    <div class="border-t border-border pt-6 text-xs leading-relaxed">
      {fill(f.disclaimer, { lastVerified: CONFIG.lastVerified })}
      {f.governingLanguage && <><br /><em class="mt-2 inline-block">{f.governingLanguage}</em></>}
    </div>
  </div>
</footer>
