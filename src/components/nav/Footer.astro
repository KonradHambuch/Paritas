---
import { getDict, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = getDict(lang);

const services = [
  { href: '#method', label: t.services.items[0]!.h },
  { href: '#services', label: t.services.items[1]!.h },
  { href: '#sale', label: t.services.items[2]!.h },
  { href: '#acquisition', label: t.services.items[3]!.h },
];
const tools = [
  { href: '#tool-tp', label: t.tools.tp.h },
  { href: '#tool-valuation', label: t.tools.valuation.h },
  { href: '#tool-readiness', label: t.tools.readiness.h },
];
---

<footer class="pb-[60px] pt-[52px] font-sans text-[0.90625rem] text-muted">
  <div class="wrap">
    <div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr]">
      <div>
        <div class="brand text-[1.125rem]">
          {t.brand.name}<span>{t.brand.tagline}</span>
        </div>
        <p class="mt-4 text-[0.90625rem]">
          {t.footer.location}<br />
          <a href={`mailto:${t.contact.email}`} class="text-body">{t.contact.email}</a>
        </p>
      </div>
      <div>
        <b class="font-normal text-ink">{t.footer.servicesHeading}</b>
        {services.map((l) => <a href={l.href} class="mt-1 block text-body">{l.label}</a>)}
      </div>
      <div>
        <b class="font-normal text-ink">{t.footer.toolsHeading}</b>
        {tools.map((l) => <a href={l.href} class="mt-1 block text-body">{l.label}</a>)}
      </div>
    </div>

    <div class="mt-[38px] border-t border-line pt-6 text-[0.8125rem] leading-relaxed">
      <p class="max-w-none">{t.footer.fine}</p>
      {t.footer.governingLanguage && <p class="mt-2 max-w-none italic">{t.footer.governingLanguage}</p>}
    </div>
  </div>
</footer>
