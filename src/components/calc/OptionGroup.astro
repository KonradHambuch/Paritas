---
interface Option {
  value: string;
  label: string;
  checked?: boolean;
}

interface Props {
  name: string;
  type?: 'radio' | 'checkbox';
  options: Option[];
  class?: string;
}

const { name, type = 'radio', options, class: cls = '' } = Astro.props;
---

<div class={`opts flex flex-wrap gap-2.5 ${cls}`}>
  {
    options.map((o) => (
      <label class:list={['opt', o.checked && 'sel']}>
        <input
          type={type}
          name={type === 'radio' ? name : o.value}
          value={type === 'radio' ? o.value : undefined}
          checked={o.checked}
        />
        {o.label}
      </label>
    ))
  }
</div>
