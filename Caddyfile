{
	admin off
	# fly.io terminates TLS at the edge; the container speaks plain HTTP.
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /srv

	encode zstd gzip

	# Astro content-hashes everything under /_astro/, so those are safely
	# immutable for a year. HTML is max-age=0 + must-revalidate rather than
	# no-store, so a repeat visit revalidates an ETag and gets a 304 instead
	# of re-downloading.
	@immutable path /_astro/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	@html path / /hu/ *.html /sitemap*.xml /robots.txt
	header @html Cache-Control "public, max-age=0, must-revalidate"

	@assets path /favicon.svg /og-*.png
	header @assets Cache-Control "public, max-age=86400"

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	# The site used to be a single file at this path; keep old links working.
	redir /paritas.html / permanent

	file_server {
		precompressed br zstd gzip
		index index.html
	}

	handle_errors {
		@hu path /hu/*
		handle @hu {
			rewrite * /hu/404/index.html
			file_server
		}
		handle {
			rewrite * /404.html
			file_server
		}
	}

	log {
		output stdout
		format console
	}
}
