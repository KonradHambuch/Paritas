# Cloudflare Pages reads this file from the deployment root.
# Compression (brotli/gzip) is handled at the edge, so it is not configured here.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og-*.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

# HTML revalidates rather than being cached hard, so a redeploy is visible
# immediately while repeat visits still get a 304 instead of a full download.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=()
